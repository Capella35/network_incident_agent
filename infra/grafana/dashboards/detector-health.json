{
  "description": "Is the Spark detector keeping up with the telemetry? Wall-clock time.",
  "editable": false,
  "graphTooltip": 1,
  "panels": [
    {
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "netops-postgres"
      },
      "description": "The dead-detector alert fires above 5 min (src/common/grafana.yaml).",
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "netops-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT coalesce(extract(epoch FROM now() - min(ingested_at)) / 60, 0) AS unscored_minutes\nFROM telemetry_raw\nWHERE ingested_at > coalesce((SELECT max(at) FROM detector_heartbeats), '-infinity')",
          "refId": "A"
        }
      ],
      "title": "Unscored telemetry waiting (minutes)",
      "type": "stat"
    },
    {
      "gridPos": {
        "h": 6,
        "w": 16,
        "x": 8,
        "y": 0
      },
      "id": 2,
      "options": {
        "alertName": "Dead detector",
        "groupMode": "default",
        "maxItems": 10,
        "sortOrder": 1,
        "stateFilter": {
          "error": true,
          "firing": true,
          "noData": true,
          "normal": true,
          "pending": true
        },
        "viewMode": "list"
      },
      "title": "Dead-detector alert",
      "type": "alertlist"
    },
    {
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "netops-postgres"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "id": 3,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "netops-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(ingested_at, '1m'), count(*) AS telemetry_stored\nFROM telemetry_raw WHERE $__timeFilter(ingested_at)\nGROUP BY 1 ORDER BY 1",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "netops-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(at, '1m'), sum(rows_scored) AS rows_scored,\n  sum(alarms) AS alarms, sum(rows_late) AS rows_late\nFROM detector_heartbeats WHERE $__timeFilter(at)\nGROUP BY 1 ORDER BY 1",
          "refId": "B"
        }
      ],
      "title": "Telemetry stored vs rows scored, per minute (wall clock)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "netops-postgres"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 15
      },
      "id": 4,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "netops-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT at, job_id, batch_id, detector_version, rows_scored, rows_late, alarms,\n  latest_interval\nFROM detector_heartbeats ORDER BY at DESC LIMIT 20",
          "refId": "A"
        }
      ],
      "title": "Latest detector heartbeats",
      "type": "table"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": [
    "netops",
    "synthetic-topology"
  ],
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timezone": "utc",
  "title": "Detector health (milestone 2)",
  "uid": "netops-detector-health",
  "version": 1
}
