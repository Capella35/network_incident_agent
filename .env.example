# Copy to .env and fill in. Fake placeholder values only; never commit .env.
# The stack refuses to start while any password below still equals its placeholder
# (infra/preflight.sh) or is shorter than 12 characters.
# Generate one with:  python3 -c "import secrets; print(secrets.token_urlsafe(24))"

KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Host-side ports. 5433 / 5001 avoid a local Homebrew Postgres (5432) and macOS AirPlay (5000).
# 127.0.0.1, not localhost: localhost can resolve to ::1, where those other services listen.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=netops
# Superuser: schema setup only. Applications use the two roles below.
POSTGRES_USER=netops_admin
POSTGRES_PASSWORD=change-me
# Producer / sink (writes telemetry and topology)
PIPELINE_WRITER_PASSWORD=change-me
# Grafana and the ops agent (SELECT only)
READONLY_PASSWORD=change-me

GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=change-me

MLFLOW_PORT=5001
MLFLOW_TRACKING_URI=http://127.0.0.1:5001

# Ops agent (optional; off by default). Provider is swappable behind src/agent/.
LLM_PROVIDER=groq
LLM_MODEL=TODO-chosen-at-milestone-5
LLM_API_KEY=your-api-key-here
